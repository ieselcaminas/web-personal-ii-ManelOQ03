{% extends 'base.html.twig' %}

{% block title %}Images{% endblock %}

{% block body %}
    <!-- Principal content section -->
	<section class="contact_section layout_padding">
	  <div id="images">
   	    <div class="container">
          <div class="col-md-12">
   	        <div class="d-flex mb-4 ml-4 ml-md-0">
       	       <h1 class="custom_heading text-center">Images</h1>
            </div>   
          </div>

          <div  class="col-md-6">
            {{ form(form, {'attr': {'class':'form-horizontal'}}) }}	
               <hr>
          </div>

		      <div  class="col-md-12">
			     <table class="table">
			       <thead>
			       <tr>
			   	     <th scope="col">#</th>
				       <th scope="col">File</th>
               <th scope="col">Views</th>
               <th scope="col">Likes</th>
               <th scope="col">Downloads</th>
               <th scope="col">Category</th>
			       </tr>
			       </thead>
			     <tbody>
			     {% for image in images %}
			     <tr>
			       <th scope="row">{{ image.id }}</th>
             <td>

			         <img src="{{ asset('images/index/gallery/' ~ image.file) }}" class="alpargata">
			       </td>
			       <td>
			         {{ image.numViews }}
			       </td>
             <td>
			         {{ image.numLikes }}
			       </td>
             <td>
			         {{ image.numDonwLoads }}
			       </td>
             <td>
			         {{ image.category.name }}
			       </td>
			     </tr>
			     {% endfor %}
			     </tbody>
			     </table>
           </div>

   	    </div>
     </div>
   </section>
	<!-- end Principal content section -->
{% endblock %}