{% extends 'base.html.twig' %}

{% block title %}Categories{% endblock %}

{% block body %}
    <!-- Principal content section -->
	<section class="contact_section layout_padding">
	  <div id="categories">
   	    <div class="container">
		  <div class="col-md-6">
   	        <div class="d-flex mb-4 ml-4 ml-md-0">
       	       <h1 class="custom_heading text-center">Categories</h1>
			</div>   
		  </div>

		  <div  class="col-md-6">
		    {{ form(form, {'attr': {'class':'form-horizontal'}}) }}	
               <hr>
		  </div>

		  <div  class="col-md-6">
			     <table class="table">
			       <thead>
			       <tr>
			   	     <th scope="col">#</th>
				     <th scope="col">Name</th>
			       </tr>
			       </thead>
			     <tbody>
			     {% for category in categories %}
			     <tr>
			       <th scope="row">{{ category.id }}</th>
			       <td>
			         {{ category.name }}
			       </td>
			     </tr>
			     {% endfor %}
			     </tbody>
			     </table>
		  </div>   
   	    </div>
     </div>
   </section>
	<!-- end Principal content section -->
{% endblock %}